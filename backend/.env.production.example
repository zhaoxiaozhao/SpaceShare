# =============================================================
# 友邻座 - 生产环境变量模板
# 复制为 .env.production 并填入真实值（切勿提交到仓库）
# 微信云托管：环境变量在服务配置中设置，优先级高于 appsettings
# =============================================================

# ---- 数据库（腾讯云数据库 MySQL）----
Database__Provider=MySql
ConnectionStrings__Default=Server=10.6.102.132;Port=3306;Database=friendlyseat;User=root;Password=你的数据库密码

# ---- Redis（腾讯云 Redis，需放通访问）----
Redis__ConnectionString=10.6.102.132:6379
Redis__Enabled=true

# ---- JWT（生产必须更换！至少32位随机）----
Jwt__Key=请更换为强随机密钥

# ---- 微信小程序凭据 ----
Wechat__AppId=wx342e7af119449059
Wechat__AppSecret=你的小程序AppSecret

# ---- 运行环境 ----
ASPNETCORE_ENVIRONMENT=Production
