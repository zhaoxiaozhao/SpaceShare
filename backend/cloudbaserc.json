{
  "version": "2.0",
  "envId": "{{env.envId}}",
  "framework": {
    "name": "friendlyseat",
    "plugins": {
      "server": {
        "version": "1.0.0",
        "provider": "cloudbaserun",
        "inputs": {
          "serviceName": "friendlyseat-api",
          "deployType": "dockerfile",
          "dockerfilePath": "backend/Dockerfile",
          "buildDir": "backend",
          "servicePath": "/",
          "ports": [
            {
              "containerPort": 80,
              "protocol": "http"
            }
          ],
          "cpu": 1,
          "mem": 0.5,
          "minNum": 0,
          "maxNum": 3,
          "policyType": "cpu",
          "policyThreshold": 60,
            "envParams": {
            "ASPNETCORE_ENVIRONMENT": "Production",
            "Database__Provider": "MySql",
            "ConnectionStrings__Default": "Server=10.6.102.132;Port=3306;Database=friendlyseat;User=root;Password=REPLACE_IN_ENV",
            "Redis__Enabled": "false",
            "Jwt__Key": "DkEP9hFbvYUOcxvVyZqriOpmaIRSfTETD5q-CYF2A__vbs8gwv9yLWvvE---RXN-",
            "Wechat__AppId": "",
            "Wechat__AppSecret": ""
          },
          "healthCheck": {
            "enable": true,
            "path": "/api/v1/cities",
            "healthyThreshold": 1,
            "unhealthyThreshold": 3
          }
        }
      }
    }
  }
}
